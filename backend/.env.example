# Ollama Cloud API key (https://ollama.com)
OLLAMA_API_KEY=

# Hugging Face access token (only needed for gated models; bge-small-en-v1.5 is public)
HUGGINGFACE_TOKEN=

# Postgres connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=study_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Model configuration
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Chunking
CHUNK_TOKEN_SIZE=500
CHUNK_TOKEN_OVERLAP=50

# Retrieval
RETRIEVAL_TOP_K=8
RRF_K=60

# Cache TTLs (seconds)
QUERY_CACHE_TTL=3600
ANSWER_CACHE_TTL=3600

# CORS (JSON array of allowed frontend origins)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
