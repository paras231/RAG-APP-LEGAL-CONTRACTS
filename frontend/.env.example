# Base URL for the backend API.
# In dev, leave as /api — vite.config.js proxies it to http://localhost:8000.
# On Netlify, set this as a site environment variable (Site settings ->
# Environment variables) to your deployed Render backend's origin, with NO
# trailing slash, e.g. https://studymate-backend.onrender.com — Vite bakes
# this in at build time, so changing it requires a redeploy.
VITE_API_BASE_URL=/api
